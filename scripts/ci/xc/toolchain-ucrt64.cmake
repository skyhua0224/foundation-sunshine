# Cross-compile the Windows host on Linux: the Fedora UCRT64 MinGW-w64 GCC, headers and CRT, plus the MSYS2 UCRT64
# packages the Windows build installs with pacman (unpacked by msys2-sysroot.py under MSYS2_ROOT).
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
set(_t x86_64-w64-mingw32ucrt)
set(CMAKE_C_COMPILER ${_t}-gcc)
set(CMAKE_CXX_COMPILER ${_t}-g++)
set(CMAKE_RC_COMPILER ${_t}-windres)
set(CMAKE_AR ${_t}-ar)
set(CMAKE_RANLIB ${_t}-ranlib)
set(MSYS2_ROOT "$ENV{MSYS2_ROOT}")
set(_p "${MSYS2_ROOT}/ucrt64")
set(CMAKE_FIND_ROOT_PATH "${_p}" "/usr/${_t}/sys-root/ucrt")
set(CMAKE_PREFIX_PATH "${_p}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY BOTH)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE BOTH)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE BOTH)
set(_cf "$ENV{CASEFIX_DIR}")
set(CMAKE_C_FLAGS_INIT "-isystem ${_p}/include -isystem ${_cf}")
set(CMAKE_CXX_FLAGS_INIT "-isystem ${_p}/include -isystem ${_cf}")
set(_cl "$ENV{CASEFIX_LIB_DIR}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-B${_p}/lib -L${_p}/lib -L${_cl}")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-B${_p}/lib -L${_p}/lib -L${_cl}")
